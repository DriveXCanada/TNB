# PostgreSQL connection string (Railway sets this automatically when you add a Postgres service)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tnb?schema=tnb"

# Public URL of the app, used in client tracking links and emails
APP_URL="http://localhost:3000"

# Email (attempt updates, affidavits, employee invitations). Sender for either option:
MAIL_FROM="TNB Process Serving <notices@yourdomain.com>"

# Option A (recommended on Railway): Resend API key – works on every plan
RESEND_API_KEY=""

# Option B: SMTP (e.g. Gmail / Google Workspace app password). Railway blocks SMTP below the Pro plan.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
