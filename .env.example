# PostgreSQL connection string (Railway sets this automatically when you add a Postgres service)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tnb?schema=tnb"

# Public URL of the app, used in client tracking links and emails
APP_URL="http://localhost:3000"

# Optional: SMTP settings to email clients when a new attempt is logged
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
